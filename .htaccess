# Shashikant Prasad Platform — Apache / LiteSpeed Directives
RewriteEngine On
RewriteBase /

# Ensure trailing slash for directory requests so relative assets resolve properly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ $1/ [R=301,L]

# Prevent directory browsing
Options -Indexes +FollowSymLinks

# Cache control: Force revalidation on HTML and JS scripts to avoid stale client cache
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
